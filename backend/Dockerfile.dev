FROM node:20-alpine

WORKDIR /app

# Skip puppeteer browser download
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Install tools and Go
RUN apk add --no-cache curl bind-tools unzip git go nmap

# Set Go environment
ENV GOPATH=/root/go
ENV PATH=$PATH:/root/go/bin:/usr/local/go/bin

# Install subfinder binary
RUN curl -sL https://github.com/projectdiscovery/subfinder/releases/download/v2.6.7/subfinder_2.6.7_linux_amd64.zip -o /tmp/subfinder.zip && \
    unzip /tmp/subfinder.zip -d /tmp && \
    mv /tmp/subfinder /usr/local/bin/ && \
    chmod +x /usr/local/bin/subfinder && \
    rm -rf /tmp/*

# Install ffuf binary
RUN curl -sL https://github.com/ffuf/ffuf/releases/download/v2.1.0/ffuf_2.1.0_linux_amd64.tar.gz -o /tmp/ffuf.tar.gz && \
    tar -xzf /tmp/ffuf.tar.gz -C /tmp && \
    mv /tmp/ffuf /usr/local/bin/ && \
    chmod +x /usr/local/bin/ffuf && \
    rm -rf /tmp/*

# Install shuffledns binary
RUN curl -sL https://github.com/projectdiscovery/shuffledns/releases/download/v1.1.0/shuffledns_1.1.0_linux_amd64.zip -o /tmp/shuffledns.zip && \
    unzip /tmp/shuffledns.zip -d /tmp && \
    mv /tmp/shuffledns /usr/local/bin/ && \
    chmod +x /usr/local/bin/shuffledns && \
    rm -rf /tmp/*

# Install dnsx binary (for dynamic DNS brute)
RUN curl -sL https://github.com/projectdiscovery/dnsx/releases/download/v1.2.1/dnsx_1.2.1_linux_amd64.zip -o /tmp/dnsx.zip && \
    unzip /tmp/dnsx.zip -d /tmp && \
    mv /tmp/dnsx /usr/local/bin/ && \
    chmod +x /usr/local/bin/dnsx && \
    rm -rf /tmp/*

# Install httpx binary
RUN curl -sL https://github.com/projectdiscovery/httpx/releases/download/v1.6.10/httpx_1.6.10_linux_amd64.zip -o /tmp/httpx.zip && \
    unzip /tmp/httpx.zip -d /tmp && \
    mv /tmp/httpx /usr/local/bin/ && \
    chmod +x /usr/local/bin/httpx && \
    rm -rf /tmp/*

# Install nuclei binary
RUN curl -sL https://github.com/projectdiscovery/nuclei/releases/download/v3.3.7/nuclei_3.3.7_linux_amd64.zip -o /tmp/nuclei.zip && \
    unzip /tmp/nuclei.zip -d /tmp && \
    mv /tmp/nuclei /usr/local/bin/ && \
    chmod +x /usr/local/bin/nuclei && \
    rm -rf /tmp/*

# Install katana binary
RUN curl -sL https://github.com/projectdiscovery/katana/releases/download/v1.1.0/katana_1.1.0_linux_amd64.zip -o /tmp/katana.zip && \
    unzip /tmp/katana.zip -d /tmp && \
    mv /tmp/katana /usr/local/bin/ && \
    chmod +x /usr/local/bin/katana && \
    rm -rf /tmp/*

# Install amass binary
RUN curl -sL https://github.com/owasp-amass/amass/releases/download/v4.2.0/amass_Linux_amd64.zip -o /tmp/amass.zip && \
    unzip /tmp/amass.zip -d /tmp && \
    mv /tmp/amass_Linux_amd64/amass /usr/local/bin/ && \
    chmod +x /usr/local/bin/amass && \
    rm -rf /tmp/*

# Install gau binary
RUN curl -sL https://github.com/lc/gau/releases/download/v2.2.4/gau_2.2.4_linux_amd64.tar.gz -o /tmp/gau.tar.gz && \
    tar -xzf /tmp/gau.tar.gz -C /tmp && \
    mv /tmp/gau /usr/local/bin/ && \
    chmod +x /usr/local/bin/gau && \
    rm -rf /tmp/*

# Install feroxbuster binary
RUN curl -sL https://github.com/epi052/feroxbuster/releases/download/v2.11.0/x86_64-linux-feroxbuster.tar.gz -o /tmp/feroxbuster.tar.gz && \
    tar -xzf /tmp/feroxbuster.tar.gz -C /tmp && \
    mv /tmp/feroxbuster /usr/local/bin/ && \
    chmod +x /usr/local/bin/feroxbuster && \
    rm -rf /tmp/*

# Install findomain binary
RUN curl -sL https://github.com/Findomain/Findomain/releases/download/9.0.4/findomain-linux.zip -o /tmp/findomain.zip && \
    unzip /tmp/findomain.zip -d /tmp && \
    mv /tmp/findomain /usr/local/bin/ && \
    chmod +x /usr/local/bin/findomain && \
    rm -rf /tmp/*

# Install urlfinder binary
RUN curl -sL https://github.com/projectdiscovery/urlfinder/releases/download/v0.0.3/urlfinder_0.0.3_linux_amd64.zip -o /tmp/urlfinder.zip && \
    unzip /tmp/urlfinder.zip -d /tmp && \
    mv /tmp/urlfinder /usr/local/bin/ && \
    chmod +x /usr/local/bin/urlfinder && \
    rm -rf /tmp/*

# Install hakrawler via go
RUN go install github.com/hakluke/hakrawler@latest

# Install waybackurls via go
RUN go install github.com/tomnomnom/waybackurls@latest

# Install assetfinder via go
RUN go install github.com/tomnomnom/assetfinder@latest

# Install dnsgen (Python tool)
RUN apk add --no-cache python3 py3-pip && \
    pip3 install dnsgen --break-system-packages

# Install massdns
RUN apk add --no-cache --virtual .build-deps build-base && \
    git clone https://github.com/blechschmidt/massdns.git /tmp/massdns && \
    cd /tmp/massdns && make && cp bin/massdns /usr/local/bin/ && \
    rm -rf /tmp/massdns && \
    apk del .build-deps

# Create resolvers file with public DNS servers
RUN echo "8.8.8.8" > /app/resolvers.txt && \
    echo "8.8.4.4" >> /app/resolvers.txt && \
    echo "1.1.1.1" >> /app/resolvers.txt && \
    echo "1.0.0.1" >> /app/resolvers.txt && \
    echo "9.9.9.9" >> /app/resolvers.txt && \
    echo "149.112.112.112" >> /app/resolvers.txt

# Create wordlists directory and download common wordlists
RUN mkdir -p /app/wordlists && \
    curl -sL https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/common.txt -o /app/wordlists/common.txt && \
    curl -sL https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/big.txt -o /app/wordlists/big.txt

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 4000

# Start in development mode with hot-reload
CMD ["npm", "run", "start:dev"]
