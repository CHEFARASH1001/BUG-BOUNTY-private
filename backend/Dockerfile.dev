FROM node:20-alpine

WORKDIR /app

# Skip puppeteer browser download
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 4000

# Start in development mode with hot-reload
CMD ["npm", "run", "start:dev"]
