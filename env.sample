# ===========================================
# Bug Bounty Automation Platform - Environment
# ===========================================
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=bugbounty2024

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# ===========================================
# External API Keys (Get from respective services)
# ===========================================

# Shodan (https://account.shodan.io/)
SHODAN_API_KEY=

# SecurityTrails (https://securitytrails.com/app/account)
SECURITYTRAILS_API_KEY=

# VirusTotal (https://www.virustotal.com/gui/user/apikey)
VIRUSTOTAL_API_KEY=

# Censys (https://search.censys.io/account/api)
CENSYS_API_ID=
CENSYS_API_SECRET=

# Hunter.io (https://hunter.io/api_keys)
HUNTER_API_KEY=

# GitHub (for code/secret scanning)
GITHUB_TOKEN=

# AlienVault OTX (https://otx.alienvault.com/api)
ALIENVAULT_API_KEY=

# URLScan.io (https://urlscan.io/user/profile/)
URLSCAN_API_KEY=

# ===========================================
# Notification Services
# ===========================================

# Slack Webhook
SLACK_WEBHOOK_URL=

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=bugbounty@yourdomain.com

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===========================================
# Optional Services
# ===========================================

# AWS S3 (for storing screenshots/reports)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Google Cloud Vision (for screenshot analysis)
GOOGLE_CLOUD_KEY=

